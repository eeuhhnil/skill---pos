// Account Service Database — ERD (dbdiagram.io DBML)
// Paste file này vào https://dbdiagram.io để render diagram
// Database: accountdb | Schema: dbo
// Updated: 2026-06-02

// ─────────────────────────────────────────
// GROUP: Identity
// ─────────────────────────────────────────

Table ep_user {
  id           int          [pk, increment]
  username     varchar(100)
  password     varchar(255)
  full_name    nvarchar(255)
  email        varchar(150)
  phone_number varchar(20)
  address      nvarchar(500)
  is_manager   bit
  authority    varchar(100)
  status       int          [note: '0=inactive, 1=active']
  type         varchar(50)
  password_version int

  Note: 'Danh tính người dùng hệ thống POS. Thay thế bảng account cũ.'
}

Table otp {
  id           int      [pk, increment]
  username     varchar(100) [ref: > ep_user.username, note: 'soft ref by username string']
  OTP          varchar(10)
  expired_time datetime
  type         int      [note: '1=reset password, 2=verify email']
  status       int      [note: '0=used, 1=active']
  send_type    int      [note: '1=email, 2=sms']

  Note: 'OTP xác thực — liên kết với ep_user qua username (không phải id)'
}

// ─────────────────────────────────────────
// GROUP: Company
// ─────────────────────────────────────────

Table company_owner {
  id                   int          [pk, increment]
  name                 nvarchar(255)
  address              nvarchar(500)
  tax_code             nvarchar(50)
  owner_name           nvarchar(255)
  owner_id             int          [ref: > ep_user.id, note: 'user admin của công ty cha']
  ikey                 varchar(100)
  revenue_group        int
  tax_register_status  int
  crm_ref              nvarchar(255)

  Note: 'Công ty cha — tổ chức sở hữu nhiều chi nhánh (company).'
}

Table company {
  id               int          [pk, increment]
  com_owner_id     int          [ref: > company_owner.id]
  name             nvarchar(255)
  phone            varchar(20)
  address          nvarchar(500)
  email            varchar(150)
  tax_code         varchar(50)
  is_parent        bit
  business_type    int
  service          varchar(100)
  shop_code        varchar(50)
  integration_type nvarchar(100)

  Note: 'Chi nhánh / cửa hàng thuộc company_owner.'
}

Table config {
  id          int          [pk, increment]
  company_id  int          [ref: > company.id]
  code        nvarchar(100)
  value       nvarchar(max)
  description nvarchar(500)
  platform    nvarchar(50)

  Note: 'Cấu hình key-value per chi nhánh.'
}

// ─────────────────────────────────────────
// GROUP: Package
// ─────────────────────────────────────────

Table package {
  id            int          [pk, increment]
  package_code  nvarchar(50)
  package_name  nvarchar(255)
  description   nvarchar(500)
  limit_company int
  limit_user    int
  limit_voucher int
  time          int          [note: 'số ngày hiệu lực']
  type          varchar(50)
  status        int

  Note: 'Định nghĩa gói dịch vụ (master data).'
}

Table owner_package {
  id            int      [pk, increment]
  owned_id      int      [ref: > company_owner.id]
  package_id    int      [ref: > package.id]
  status        int      [note: '0=expired, 1=active']
  start_date    datetime
  end_date      datetime
  pack_count    int
  voucher_using int

  Note: 'Subscription: company_owner đang dùng package nào, trong thời hạn nào.'
}

// ─────────────────────────────────────────
// GROUP: RBAC
// ─────────────────────────────────────────

Table role {
  id              int          [pk, increment]
  code            varchar(100)
  name            nvarchar(255)
  type            int
  com_id          int          [ref: > company.id, note: 'FK → company.id (cùng DB)']
  normalized_name varchar(255)

  Note: 'Định nghĩa vai trò RBAC. com_id là FK thật → company.id.'
}

Table permission {
  id          int          [pk, increment]
  code        varchar(100)
  parent_id   int          [ref: > permission.id, note: 'self-ref: cây phân quyền']
  parent_code varchar(100)
  name        nvarchar(255)
  description nvarchar(500)

  Note: 'Cây phân quyền. parent_id tự tham chiếu để tạo cấu trúc phân cấp.'
}

Table role_permission {
  id                     int         [pk, increment]
  role_id                int         [ref: > role.id]
  permission_id          int         [ref: > permission.id]
  role_code              varchar(100)
  permission_code        varchar(100)
  permission_parent_code varchar(100)

  Note: 'Junction table: ánh xạ role ↔ permission (n-n)'
}

// ─────────────────────────────────────────
// GROUP: Access Control
// ─────────────────────────────────────────

Table user_role {
  id      int [pk, increment]
  user_id int [ref: > ep_user.id]
  role_id int [ref: > role.id]
  com_id  int [ref: > company.id, note: 'FK thật → company.id (cùng DB)']

  Note: 'Junction table: ánh xạ user ↔ role theo từng chi nhánh.'
}

Table company_user {
  id               int  [pk, increment]
  company_id       int  [ref: > company.id, note: 'FK thật → company.id (cùng DB)']
  user_id          int  [ref: > ep_user.id]
  shift_management bit
  status           int  [note: '0=inactive, 1=active']

  Note: 'Quyền truy cập của user theo chi nhánh.'
}

// ─────────────────────────────────────────
// GROUPS (visual grouping trên diagram)
// ─────────────────────────────────────────

TableGroup Identity {
  ep_user
  otp
}

TableGroup Company {
  company_owner
  company
  config
}

TableGroup Package {
  package
  owner_package
}

TableGroup RBAC {
  role
  permission
  role_permission
}

TableGroup AccessControl {
  user_role
  company_user
}
