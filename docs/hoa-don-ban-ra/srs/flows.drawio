<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="2000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="700" math="0" shadow="0">
  <root>
